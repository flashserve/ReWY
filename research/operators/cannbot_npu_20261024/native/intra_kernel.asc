#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "residual_config.h"
using namespace AscendC;
namespace {
constexpr uint32_t M=KDA_INTRA_M, C=64, K=128, N=KDA_INTRA_N;
constexpr uint32_t NK=K/N, NR=C/M;
constexpr float Ln2=0.6931471805599453094f;
using Low=bfloat16_t;
using An=MatmulType<TPosition::VECCALC,CubeFormat::ND,Low>;
using At=MatmulType<TPosition::VECCALC,CubeFormat::ND,Low,true>;
using Co=MatmulType<TPosition::VECCALC,CubeFormat::ND,float>;
struct Intra {
    Matmul<An,An,Co> forward;
    Matmul<At,An,Co> backward;
    TBuf<TPosition::VECCALC> afb, alb, blb, lowb, gb, qb, kb, pb, mb;
    TBuf<TPosition::VECCALC> Qb,Eb,Yb,tmpb,workb,rowb;
    LocalTensor<float> af,g,q,k,plus,minus,Q,E,Y,tmp,work,rows;
    LocalTensor<Low> al,bl,low;
    GlobalTensor<Low> qg,kg,bg;
    GlobalTensor<float> gg,L,D,dqi,dki,dgi,de,dqo,dko,dgo,db;
    GlobalTensor<int32_t> flags;
    IntraConfig cfg;
    __aicore__ inline void Init(TPipe& pipe, GM_ADDR q_,GM_ADDR k_,GM_ADDR g_,GM_ADDR b_,
        GM_ADDR l_,GM_ADDR d_,GM_ADDR dq_,GM_ADDR dk_,GM_ADDR dg_,GM_ADDR de_,
        GM_ADDR oq_,GM_ADDR ok_,GM_ADDR og_,GM_ADDR db_,GM_ADDR flags_,IntraConfig c) {
        cfg=c;
        qg.SetGlobalBuffer((__gm__ Low*)q_); kg.SetGlobalBuffer((__gm__ Low*)k_);
        bg.SetGlobalBuffer((__gm__ Low*)b_); gg.SetGlobalBuffer((__gm__ float*)g_);
        L.SetGlobalBuffer((__gm__ float*)l_); D.SetGlobalBuffer((__gm__ float*)d_);
        dqi.SetGlobalBuffer((__gm__ float*)dq_); dki.SetGlobalBuffer((__gm__ float*)dk_);
        dgi.SetGlobalBuffer((__gm__ float*)dg_); de.SetGlobalBuffer((__gm__ float*)de_);
        dqo.SetGlobalBuffer((__gm__ float*)oq_); dko.SetGlobalBuffer((__gm__ float*)ok_);
        dgo.SetGlobalBuffer((__gm__ float*)og_); db.SetGlobalBuffer((__gm__ float*)db_);
        flags.SetGlobalBuffer((__gm__ int32_t*)flags_);
        pipe.InitBuffer(afb,M*C*4); pipe.InitBuffer(alb,M*C*2);
        pipe.InitBuffer(blb,C*N*2); pipe.InitBuffer(lowb,C*N*2);
        pipe.InitBuffer(gb,C*N*4); pipe.InitBuffer(qb,C*N*4); pipe.InitBuffer(kb,C*N*4);
        pipe.InitBuffer(pb,C*N*4); pipe.InitBuffer(mb,C*N*4);
        pipe.InitBuffer(Qb,M*N*4); pipe.InitBuffer(Eb,M*N*4); pipe.InitBuffer(Yb,M*N*4);
        pipe.InitBuffer(tmpb,M*N*4); pipe.InitBuffer(workb,C*N*4); pipe.InitBuffer(rowb,1024*4);
        af=afb.Get<float>(); al=alb.Get<Low>(); bl=blb.Get<Low>(); low=lowb.Get<Low>();
        g=gb.Get<float>(); q=qb.Get<float>(); k=kb.Get<float>();
        plus=pb.Get<float>(); minus=mb.Get<float>(); Q=Qb.Get<float>(); E=Eb.Get<float>();
        Y=Yb.Get<float>(); tmp=tmpb.Get<float>(); work=workb.Get<float>(); rows=rowb.Get<float>();
    }
    __aicore__ inline void Loaded(){SetFlag<HardEvent::MTE2_V>(EVENT_ID0);WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);}
    __aicore__ inline void LoadReady(){SetFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);}
    __aicore__ inline void StoreReady(){SetFlag<HardEvent::V_MTE3>(EVENT_ID0);WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);}
    __aicore__ inline void Stored(){SetFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);}
    template<class T> __aicore__ inline void Load(const LocalTensor<T>& dst,const GlobalTensor<T>& src,uint32_t h,uint32_t w,uint32_t stride){
        LoadReady();
        DataCopy(dst,src,DataCopyParams{uint16_t(h),uint16_t(w*sizeof(T)/32),uint16_t((stride-w)*sizeof(T)/32),0});
    }
    __aicore__ inline void Store(const GlobalTensor<float>& dst,const LocalTensor<float>& src){
        StoreReady(); DataCopy(dst,src,DataCopyParams{M,N*4/32,0,uint16_t((cfg.heads*K-N)*4/32)}); Stored();
    }
    __aicore__ inline void ScalarCoef(const GlobalTensor<float>& src,uint32_t h,uint32_t w){
        SetFlag<HardEvent::S_MTE2>(EVENT_ID0);WaitFlag<HardEvent::S_MTE2>(EVENT_ID0);
        Load(af,src,h,w,cfg.heads*C);
        SetFlag<HardEvent::MTE2_S>(EVENT_ID0);WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    }
    __aicore__ inline void Mat(const GlobalTensor<float>& coeff,uint64_t base,uint32_t row,
        const LocalTensor<float>& rhs,const LocalTensor<float>& out,bool trans){
        if(trans) Load(af,coeff[base*C+row],C,M,cfg.heads*C);
        else Load(af,coeff[(base+uint64_t(row)*cfg.heads)*C],M,C,cfg.heads*C);
        Loaded(); Cast(al,af,RoundMode::CAST_RINT,M*C); Cast(bl,rhs,RoundMode::CAST_RINT,C*N); PipeBarrier<PIPE_V>();
        if(trans){backward.SetTensorA(al,true);backward.SetTensorB(bl);backward.IterateAll(out);backward.End();}
        else{forward.SetTensorA(al);forward.SetTensorB(bl);forward.IterateAll(out);forward.End();}
        PipeBarrier<PIPE_ALL>();
    }
    __aicore__ inline bool Gates(){
        if constexpr(KDA_INTRA_GLOBAL_ANCHOR){
            WholeReduceMin(rows[128],g,64,C*N/64,1,1,8,ReduceOrder::ORDER_ONLY_VALUE);
            WholeReduceMax(rows[192],g,64,C*N/64,1,1,8,ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
            WholeReduceMin(rows[256],rows[128],C*N/64,1,1,1,8,ReduceOrder::ORDER_ONLY_VALUE);
            WholeReduceMax(rows[264],rows[192],C*N/64,1,1,1,8,ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_ALL>();
            float minimum=rows.GetValue(256),maximum=rows.GetValue(264);
            if(!(maximum-minimum<80.0f))return false;
            float center=(minimum+maximum)*0.5f;
            Adds(plus,g,-center,C*N);PipeBarrier<PIPE_V>();Muls(plus,plus,Ln2,C*N);PipeBarrier<PIPE_V>();
            Muls(minus,plus,-1.0f,C*N);PipeBarrier<PIPE_V>();Exp(plus,plus,C*N);Exp(minus,minus,C*N);PipeBarrier<PIPE_V>();
            return true;
        }
        DataCopy(rows[128],g,N); DataCopy(rows[128+N],g,N); PipeBarrier<PIPE_V>();
        for(uint32_t i=1;i<C;++i){Min(rows[128],rows[128],g[i*N],N);Max(rows[128+N],rows[128+N],g[i*N],N);PipeBarrier<PIPE_V>();}
        Sub(rows[128+2*N],rows[128+N],rows[128],N); Add(rows[128+3*N],rows[128+N],rows[128],N);PipeBarrier<PIPE_V>();
        Muls(rows[128+3*N],rows[128+3*N],0.5f,N);PipeBarrier<PIPE_ALL>();
        bool safe=true;
        for(uint32_t j=0;j<N;++j) if(!(rows.GetValue(128+2*N+j)<80.0f))safe=false;
        if(safe){
            for(uint32_t i=0;i<C;++i){Sub(plus[i*N],g[i*N],rows[128+3*N],N);}
            PipeBarrier<PIPE_V>(); Muls(plus,plus,Ln2,C*N);PipeBarrier<PIPE_V>();
            Muls(minus,plus,-1.0f,C*N);PipeBarrier<PIPE_V>();
            Exp(plus,plus,C*N);Exp(minus,minus,C*N);PipeBarrier<PIPE_V>();
        }
        return safe;
    }
    __aicore__ inline void Matrix(uint64_t base,uint32_t row){
        Mul(work,k,minus,C*N);PipeBarrier<PIPE_V>(); Mat(L,base,row,work,Q,false);Mat(D,base,row,work,E,false);
        Mul(Q,Q,plus[row*N],M*N);Mul(E,E,plus[row*N],M*N);PipeBarrier<PIPE_V>();
        Mul(work,q,plus,C*N);PipeBarrier<PIPE_V>();Mat(L,base,row,work,Y,true);
        Mul(work,k,plus,C*N);PipeBarrier<PIPE_V>();
        for(uint32_t i=0;i<C;++i)Muls(work[i*N],work[i*N],rows.GetValue(i),N);
        PipeBarrier<PIPE_V>();Mat(D,base,row,work,tmp,true);Add(Y,Y,tmp,M*N);PipeBarrier<PIPE_V>();
        Mul(Y,Y,minus[row*N],M*N);PipeBarrier<PIPE_V>();
    }
    // Strong/non-monotonic gate fallback evaluates only valid causal pairs before exp.
    // Coefficients stay FP32 here, matching the old pairwise precision boundary.
    __aicore__ inline void Pairwise(uint64_t base,uint32_t row){
        Duplicate(Q,0.0f,M*N);Duplicate(E,0.0f,M*N);Duplicate(Y,0.0f,M*N);PipeBarrier<PIPE_V>();
        ScalarCoef(L[(base+uint64_t(row)*cfg.heads)*C],M,C);
        for(uint32_t i=0;i<M;++i)for(uint32_t j=0;j<=row+i;++j){
            Sub(work,g[(row+i)*N],g[j*N],N);PipeBarrier<PIPE_V>();Muls(work,work,Ln2,N);PipeBarrier<PIPE_V>();Exp(work,work,N);PipeBarrier<PIPE_V>();
            Mul(work,work,k[j*N],N);PipeBarrier<PIPE_V>();Muls(work,work,af.GetValue(i*C+j),N);PipeBarrier<PIPE_V>();Add(Q[i*N],Q[i*N],work,N);PipeBarrier<PIPE_V>();}
        ScalarCoef(D[(base+uint64_t(row)*cfg.heads)*C],M,C);
        for(uint32_t i=0;i<M;++i)for(uint32_t j=0;j<row+i;++j){
            Sub(work,g[(row+i)*N],g[j*N],N);PipeBarrier<PIPE_V>();Muls(work,work,Ln2,N);PipeBarrier<PIPE_V>();Exp(work,work,N);PipeBarrier<PIPE_V>();
            Mul(work,work,k[j*N],N);PipeBarrier<PIPE_V>();Muls(work,work,af.GetValue(i*C+j),N);PipeBarrier<PIPE_V>();Add(E[i*N],E[i*N],work,N);PipeBarrier<PIPE_V>();}
        ScalarCoef(L[base*C+row],C,M);
        for(uint32_t i=0;i<M;++i)for(uint32_t j=row+i;j<C;++j){
            Sub(work,g[j*N],g[(row+i)*N],N);PipeBarrier<PIPE_V>();Muls(work,work,Ln2,N);PipeBarrier<PIPE_V>();Exp(work,work,N);PipeBarrier<PIPE_V>();
            Mul(work,work,q[j*N],N);PipeBarrier<PIPE_V>();Muls(work,work,af.GetValue(j*M+i),N);PipeBarrier<PIPE_V>();Add(Y[i*N],Y[i*N],work,N);PipeBarrier<PIPE_V>();}
        ScalarCoef(D[base*C+row],C,M);
        for(uint32_t i=0;i<M;++i)for(uint32_t j=row+i+1;j<C;++j){
            Sub(work,g[j*N],g[(row+i)*N],N);PipeBarrier<PIPE_V>();Muls(work,work,Ln2,N);PipeBarrier<PIPE_V>();Exp(work,work,N);PipeBarrier<PIPE_V>();
            Mul(work,work,k[j*N],N);PipeBarrier<PIPE_V>();Muls(work,work,af.GetValue(j*M+i)*rows.GetValue(j),N);PipeBarrier<PIPE_V>();Add(Y[i*N],Y[i*N],work,N);PipeBarrier<PIPE_V>();}
    }
    __aicore__ inline void Process(){
        for(uint32_t task=GetBlockIdx();task<cfg.tasks;task+=GetBlockNum()*GetTaskRation()){
            uint32_t kt=task%NK,row=(task/NK)%NR*M,head=(task/(NK*NR))%cfg.heads;
            uint64_t chunk=task/(NK*NR*cfg.heads),base=chunk*C*cfg.heads+head,own=base+uint64_t(row)*cfg.heads;
            uint64_t feature=own*K+kt*N;
            Load(g,gg[base*K+kt*N],C,N,cfg.heads*K);
            Load(low,qg[base*K+kt*N],C,N,cfg.heads*K);Loaded();Cast(q,low,RoundMode::CAST_NONE,C*N);PipeBarrier<PIPE_V>();
            Load(low,kg[base*K+kt*N],C,N,cfg.heads*K);Loaded();Cast(k,low,RoundMode::CAST_NONE,C*N);PipeBarrier<PIPE_V>();
            DataCopyExtParams bc{C,sizeof(Low),(cfg.heads-1)*2U,0,0};DataCopyPadExtParams<Low> bp{false,0,0,Low{}};
            LoadReady();DataCopyPad(low,bg[base],bc,bp);Loaded();Cast(work,low,RoundMode::CAST_NONE,C*16);PipeBarrier<PIPE_ALL>();
            for(uint32_t i=0;i<C;++i)rows.SetValue(i,work.GetValue(i*16));
            bool safe=Gates();
            if(safe)Matrix(base,row);else Pairwise(base,row);
            // One 32-byte task slot avoids adjacent GM scalar writers sharing a DMA block.
            rows.ReinterpretCast<int32_t>().SetValue(256,safe?0:1);PipeBarrier<PIPE_ALL>();StoreReady();
            DataCopy(flags[task*8],rows.ReinterpretCast<int32_t>()[256],8);Stored();
            if(cfg.joint){
                Load(tmp,de[feature],M,N,cfg.heads*K);Loaded();Muls(work,g[row*N],Ln2,M*N);PipeBarrier<PIPE_V>();Exp(work,work,M*N);PipeBarrier<PIPE_V>();Mul(tmp,tmp,work,M*N);PipeBarrier<PIPE_V>();Add(E,E,tmp,M*N);PipeBarrier<PIPE_V>();
            }
            Mul(tmp,k[row*N],E,M*N);PipeBarrier<PIPE_V>();
            WholeReduceSum(rows[384],tmp,N,M,1,1,N/8);PipeBarrier<PIPE_ALL>();
            for(uint32_t i=0;i<M;++i)rows.SetValue(512+i*8,rows.GetValue(384+i));
            PipeBarrier<PIPE_ALL>();StoreReady();DataCopyExtParams dc{M,sizeof(float),0,(cfg.heads-1)*4U,0};
            DataCopyPad(db[uint64_t(kt)*cfg.batch*cfg.time*cfg.heads+own],rows[512],dc);Stored();
            for(uint32_t i=0;i<M;++i)Muls(E[i*N],E[i*N],rows.GetValue(row+i),N);
            PipeBarrier<PIPE_V>();
            Sub(tmp,E,Y,M*N);PipeBarrier<PIPE_V>();Mul(tmp,tmp,k[row*N],M*N);Mul(work,Q,q[row*N],M*N);PipeBarrier<PIPE_V>();Add(tmp,tmp,work,M*N);PipeBarrier<PIPE_V>();
            Load(work,dgi[feature],M,N,cfg.heads*K);Loaded();Add(tmp,tmp,work,M*N);PipeBarrier<PIPE_V>();Store(dgo[feature],tmp);
            Add(E,E,Y,M*N);PipeBarrier<PIPE_V>();Load(work,dki[feature],M,N,cfg.heads*K);Loaded();Add(E,E,work,M*N);PipeBarrier<PIPE_V>();Store(dko[feature],E);
            Load(work,dqi[feature],M,N,cfg.heads*K);Loaded();Add(Q,Q,work,M*N);PipeBarrier<PIPE_V>();Store(dqo[feature],Q);
        }
    }
};
}
extern "C" __global__ __aicore__ void kda_intra_native(GM_ADDR q,GM_ADDR k,GM_ADDR g,GM_ADDR b,
    GM_ADDR l,GM_ADDR d,GM_ADDR dq,GM_ADDR dk,GM_ADDR dg,GM_ADDR de,GM_ADDR oq,GM_ADDR ok,GM_ADDR og,
    GM_ADDR db,GM_ADDR flags,GM_ADDR workspace,IntraConfig cfg){
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    TPipe pipe;Intra op;AscendC::clearWorkspace(workspace);
    REGIST_MATMUL_OBJ(&pipe,workspace,op.forward,&cfg.forward,op.backward,&cfg.backward);
    if ASCEND_IS_AIV{op.Init(pipe,q,k,g,b,l,d,dq,dk,dg,de,oq,ok,og,db,flags,cfg);op.Process();}
}
extern "C" void launch_kda_intra_native(uint32_t blocks,void* stream,uint8_t* q,uint8_t* k,uint8_t* g,uint8_t* b,
    uint8_t* l,uint8_t* d,uint8_t* dq,uint8_t* dk,uint8_t* dg,uint8_t* de,uint8_t* oq,uint8_t* ok,uint8_t* og,
    uint8_t* db,uint8_t* flags,uint8_t* workspace,IntraConfig cfg){
    kda_intra_native<<<blocks,nullptr,stream>>>(q,k,g,b,l,d,dq,dk,dg,de,oq,ok,og,db,flags,workspace,cfg);
}
