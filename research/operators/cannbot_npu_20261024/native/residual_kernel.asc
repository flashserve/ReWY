#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "residual_config.h"

using namespace AscendC;
namespace {
constexpr uint32_t Rows = 32;
constexpr uint32_t Chunk = 64;
constexpr uint32_t Feature = 128;
constexpr uint32_t KeyTile = 64;
using Low = bfloat16_t;
using At = MatmulType<TPosition::VECCALC, CubeFormat::ND, Low, true>;
using An = MatmulType<TPosition::VECCALC, CubeFormat::ND, Low>;
using Bt = MatmulType<TPosition::VECCALC, CubeFormat::ND, Low, true>;
using Bn = MatmulType<TPosition::VECCALC, CubeFormat::ND, Low>;
using Cout = MatmulType<TPosition::VECCALC, CubeFormat::ND, float>;

// Cube 的 UB 输入/输出交换由 arch2201 MatmulClient 管理；P 的 owning UB
// 跨两个消费阶段保持有效。2201库内部含GM中转，因此不称此接口为纯片上链。
struct Cube {
    Matmul<At, Bn, Cout> producer;
    Matmul<An, Bt, Cout> consumer;
    __aicore__ inline void Produce(const LocalTensor<Low>& a,
                                   const LocalTensor<Low>& dr,
                                   const LocalTensor<float>& out) {
        producer.SetTensorA(a, true);
        producer.SetTensorB(dr);
        producer.IterateAll(out);
        producer.End();
    }
    __aicore__ inline void Consume(const LocalTensor<Low>& p,
                                   const LocalTensor<Low>& r,
                                   const LocalTensor<float>& out) {
        consumer.SetTensorA(p);
        consumer.SetTensorB(r, true);
        consumer.IterateAll(out);
        consumer.End();
    }
};

struct Vector {
    TBuf<TPosition::VECCALC> aStore, bStore, pStore, resultStore;
    TBuf<TPosition::VECCALC> wideStore, gateStore, keyStore, rowStore;
    LocalTensor<Low> a, b, p;
    LocalTensor<float> result, wide, gate, key, rows;
    __aicore__ inline void Init(TPipe& pipe) {
        pipe.InitBuffer(aStore, Chunk * Rows * sizeof(Low));
        pipe.InitBuffer(bStore, Chunk * Feature * sizeof(Low));
        pipe.InitBuffer(pStore, Rows * Feature * sizeof(Low));
        pipe.InitBuffer(resultStore, Rows * Feature * sizeof(float));
        pipe.InitBuffer(wideStore, Rows * Feature * sizeof(float));
        pipe.InitBuffer(gateStore, Rows * KeyTile * sizeof(float));
        pipe.InitBuffer(keyStore, Rows * KeyTile * sizeof(float));
        // beta[32], db[32], reduction outputs[32], reduction scratch[512]
        pipe.InitBuffer(rowStore, 1024 * sizeof(float));
        a = aStore.Get<Low>(); b = bStore.Get<Low>(); p = pStore.Get<Low>();
        result = resultStore.Get<float>(); wide = wideStore.Get<float>();
        gate = gateStore.Get<float>(); key = keyStore.Get<float>();
        rows = rowStore.Get<float>();
    }
    __aicore__ inline void LoadFence() {
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
    }
    __aicore__ inline void StoreFence() {
        SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
    }
    __aicore__ inline void ReuseFence() {
        SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
        // 同一slot后续可能由MTE2覆盖；V侧完成不保护DMA写入。
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    }
    template<class T>
    __aicore__ inline void LoadRows(const LocalTensor<T>& dst, const GlobalTensor<T>& src,
                                    uint32_t height, uint32_t width, uint32_t stride) {
        DataCopy(dst, src, DataCopyParams{static_cast<uint16_t>(height),
            static_cast<uint16_t>(width * sizeof(T) / 32),
            static_cast<uint16_t>((stride - width) * sizeof(T) / 32), 0});
    }
    template<class T>
    __aicore__ inline void StoreRows(const GlobalTensor<T>& dst, const LocalTensor<T>& src,
                                     uint32_t height, uint32_t width, uint32_t stride) {
        DataCopy(dst, src, DataCopyParams{static_cast<uint16_t>(height),
            static_cast<uint16_t>(width * sizeof(T) / 32), 0,
            static_cast<uint16_t>((stride - width) * sizeof(T) / 32)});
    }
    __aicore__ inline void ReduceRows(const LocalTensor<float>& src,
                                      const LocalTensor<float>& dst, uint32_t width) {
        // BlockReduceSum 先把每8项压成1项，下一条沿行归约；不跨行混合。
        BlockReduceSum(rows[128], src, Rows * width / 64, 64, 1, 1, 8);
        PipeBarrier<PIPE_V>();
        WholeReduceSum(dst, rows[128], width / 8, Rows, 1, 1, width / 64);
        PipeBarrier<PIPE_V>();
    }
    __aicore__ inline void ScaleBeta(const LocalTensor<float>& x, uint32_t width) {
        for (uint32_t row = 0; row < Rows; ++row) {
            Muls(x[row * width], x[row * width], rows.GetValue(row), width);
        }
        PipeBarrier<PIPE_V>();
    }
};

struct Operator {
    Cube cube;
    Vector vec;
    GlobalTensor<Low> value, residual, inverse, dr, kval, beta, dv, state;
    GlobalTensor<float> g, dk, dg, db, dm;
    ResidualConfig cfg;
    __aicore__ inline void Init(TPipe& pipe, GM_ADDR valuePtr, GM_ADDR residualPtr,
        GM_ADDR inversePtr, GM_ADDR drPtr, GM_ADDR statePtr, GM_ADDR keyPtr,
        GM_ADDR gatePtr, GM_ADDR betaPtr, GM_ADDR dkPtr, GM_ADDR dgPtr,
        GM_ADDR dvPtr, GM_ADDR dbPtr, GM_ADDR dmPtr, const ResidualConfig& config) {
        cfg = config;
        value.SetGlobalBuffer((__gm__ Low*)valuePtr);
        residual.SetGlobalBuffer((__gm__ Low*)residualPtr);
        inverse.SetGlobalBuffer((__gm__ Low*)inversePtr);
        dr.SetGlobalBuffer((__gm__ Low*)drPtr);
        kval.SetGlobalBuffer((__gm__ Low*)keyPtr);
        beta.SetGlobalBuffer((__gm__ Low*)betaPtr);
        state.SetGlobalBuffer((__gm__ Low*)statePtr);
        g.SetGlobalBuffer((__gm__ float*)gatePtr);
        dk.SetGlobalBuffer((__gm__ float*)dkPtr);
        dg.SetGlobalBuffer((__gm__ float*)dgPtr);
        dv.SetGlobalBuffer((__gm__ Low*)dvPtr);
        db.SetGlobalBuffer((__gm__ float*)dbPtr);
        dm.SetGlobalBuffer((__gm__ float*)dmPtr);
        vec.Init(pipe);
    }
    __aicore__ inline void Process() {
        for (uint32_t task = GetBlockIdx(); task < cfg.tasks; task += GetBlockNum() * GetTaskRation()) {
            const uint32_t rowHalf = task % 2;
            const uint32_t head = (task / 2) % cfg.heads;
            const uint32_t chunkGlobal = task / (2 * cfg.heads);
            const uint32_t batch = chunkGlobal / (cfg.time / Chunk);
            const uint32_t chunk = chunkGlobal % (cfg.time / Chunk);
            const uint64_t token = uint64_t(batch) * cfg.time + chunk * Chunk;
            const uint64_t start = (token * cfg.heads + head);
            const uint64_t own = start + uint64_t(rowHalf * Rows) * cfg.heads;

            // A 原布局 [B,T,H,C]，只取本32行P对应的A列；没有全量重排。
            vec.LoadRows(vec.a, inverse[start * Chunk + rowHalf * Rows], Chunk, Rows, cfg.heads * Chunk);
            vec.LoadRows(vec.b, dr[start * Feature], Chunk, Feature, cfg.heads * Feature);
            vec.LoadFence();
            cube.Produce(vec.a, vec.b, vec.result);
            PipeBarrier<PIPE_ALL>();
            Cast(vec.p, vec.result, RoundMode::CAST_RINT, Rows * Feature);
            PipeBarrier<PIPE_V>();

            // beta逐行DMA至32B对齐slot，再向量转换，避免不支持的BF16 scalar cast。
            DataCopyExtParams betaCopy{Rows, sizeof(Low), (cfg.heads - 1) * 2U, 0, 0};
            DataCopyPadExtParams<Low> betaPadding{false, 0, 0, Low{}};
            DataCopyPad(vec.a, beta[own], betaCopy, betaPadding);
            vec.LoadFence();
            Cast(vec.wide, vec.a, RoundMode::CAST_NONE, Rows * 16);
            PipeBarrier<PIPE_ALL>();
            for (uint32_t row = 0; row < Rows; ++row) {
                vec.rows.SetValue(row, vec.wide.GetValue(row * 16));
            }
            vec.LoadRows(vec.b, value[own * Feature], Rows, Feature, cfg.heads * Feature);
            vec.LoadFence();
            Cast(vec.wide, vec.b, RoundMode::CAST_NONE, Rows * Feature);
            PipeBarrier<PIPE_V>();
            Mul(vec.wide, vec.wide, vec.result, Rows * Feature);
            PipeBarrier<PIPE_V>();
            vec.ReduceRows(vec.wide, vec.rows[32], Feature);
            vec.ScaleBeta(vec.result, Feature);
            Cast(vec.b, vec.result, RoundMode::CAST_RINT, Rows * Feature);
            vec.StoreFence();
            vec.StoreRows(dv[own * Feature], vec.b, Rows, Feature, cfg.heads * Feature);
            vec.ReuseFence();

            vec.LoadRows(vec.b, residual[start * Feature], Chunk, Feature, cfg.heads * Feature);
            vec.LoadFence();
            cube.Consume(vec.p, vec.b, vec.result);
            PipeBarrier<PIPE_ALL>();
            Muls(vec.result, vec.result, -1.0f, Rows * Chunk);
            PipeBarrier<PIPE_V>();
            for (uint32_t row = 0; row < Rows; ++row) {
                const uint32_t firstZero = rowHalf * Rows + row;
                // Vector起始地址必须32B对齐；对角线通过位mask表达，不能偏移指针。
                uint64_t mask[2] = {uint64_t(-1) << firstZero, 0};
                Duplicate(vec.result[row * Chunk], 0.0f, mask, 1, 1, 8);
            }
            vec.StoreFence();
            vec.StoreRows(dm[own * Chunk], vec.result, Rows, Chunk, cfg.heads * Chunk);
            vec.ReuseFence();

            const uint64_t stateBase = (uint64_t(chunkGlobal) * cfg.heads + head) * Feature * Feature;
            const uint32_t keyHead = head / (cfg.heads / cfg.keyHeads);
            const uint64_t keyBase = ((token + rowHalf * Rows) * cfg.keyHeads + keyHead) * Feature;
            for (uint32_t keyOffset = 0; keyOffset < Feature; keyOffset += KeyTile) {
                // FLA的保存h本身是BF16；仅读取K-major tile，不更改保存精度。
                DataCopy(vec.b, state[stateBase + keyOffset * Feature], KeyTile * Feature);
                vec.LoadFence();
                cube.Consume(vec.p, vec.b, vec.result);
                PipeBarrier<PIPE_ALL>();
                Muls(vec.result, vec.result, -1.0f, Rows * KeyTile);
                vec.LoadRows(vec.gate, g[own * Feature + keyOffset], Rows, KeyTile, cfg.heads * Feature);
                vec.LoadRows(vec.a, kval[keyBase + keyOffset], Rows, KeyTile, cfg.keyHeads * Feature);
                vec.LoadFence();
                Cast(vec.key, vec.a, RoundMode::CAST_NONE, Rows * KeyTile);
                Muls(vec.gate, vec.gate, 0.6931471805599453094f, Rows * KeyTile);
                PipeBarrier<PIPE_V>();
                Exp(vec.gate, vec.gate, Rows * KeyTile);
                PipeBarrier<PIPE_V>();
                Mul(vec.result, vec.result, vec.gate, Rows * KeyTile);
                PipeBarrier<PIPE_V>();
                Mul(vec.wide, vec.result, vec.key, Rows * KeyTile);
                PipeBarrier<PIPE_V>();
                vec.ReduceRows(vec.wide, vec.rows[64], KeyTile);
                Add(vec.rows[32], vec.rows[32], vec.rows[64], Rows);
                vec.ScaleBeta(vec.result, KeyTile);
                Mul(vec.key, vec.result, vec.key, Rows * KeyTile);
                vec.LoadRows(vec.wide, dk[own * Feature + keyOffset], Rows, KeyTile, cfg.heads * Feature);
                vec.LoadFence();
                Add(vec.result, vec.result, vec.wide, Rows * KeyTile);
                vec.StoreFence();
                vec.StoreRows(dk[own * Feature + keyOffset], vec.result, Rows, KeyTile, cfg.heads * Feature);
                vec.ReuseFence();
                vec.LoadRows(vec.wide, dg[own * Feature + keyOffset], Rows, KeyTile, cfg.heads * Feature);
                vec.LoadFence();
                Add(vec.key, vec.key, vec.wide, Rows * KeyTile);
                vec.StoreFence();
                vec.StoreRows(dg[own * Feature + keyOffset], vec.key, Rows, KeyTile, cfg.heads * Feature);
                vec.ReuseFence();
            }
            // db行标量输出用DataCopyPad，避免未对齐标量GM向量写越界。
            for (uint32_t row = 0; row < Rows; ++row) {
                vec.rows.SetValue(512 + row * 8, vec.rows.GetValue(32 + row));
            }
            PipeBarrier<PIPE_ALL>();
            vec.StoreFence();
            DataCopyExtParams dbCopy{Rows, sizeof(float), 0, (cfg.heads - 1) * 4U, 0};
            DataCopyPad(db[own], vec.rows[512], dbCopy);
            vec.ReuseFence();
        }
    }
};
}

extern "C" __global__ __aicore__ void kda_residual_native(
    GM_ADDR value, GM_ADDR residual, GM_ADDR inverse, GM_ADDR dr,
    GM_ADDR state, GM_ADDR key, GM_ADDR gate, GM_ADDR beta,
    GM_ADDR dk, GM_ADDR dg, GM_ADDR dv, GM_ADDR db, GM_ADDR dm,
    GM_ADDR workspace, ResidualConfig cfg) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    TPipe pipe;
    Operator op;
    // 直调自带workspace时，显式发布REGIST AIV等待的WORKSPACE_SYNC_ID。
    // 常规CANN框架可在入口外做此步；自定义workspace不能依赖该隐式序言。
    AscendC::clearWorkspace(workspace);
    REGIST_MATMUL_OBJ(&pipe, workspace, op.cube.producer, &cfg.p, op.cube.consumer, &cfg.consume);
    if ASCEND_IS_AIV {
        op.Init(pipe, value, residual, inverse, dr, state, key, gate, beta, dk, dg, dv, db, dm, cfg);
        op.Process();
    }
}

extern "C" __global__ __aicore__ void kda_matmul_probe(
    GM_ADDR a, GM_ADDR dr, GM_ADDR out, GM_ADDR workspace, ResidualConfig cfg) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    TPipe pipe;
    Cube cube;
    Vector vec;
    AscendC::clearWorkspace(workspace);
    REGIST_MATMUL_OBJ(&pipe, workspace, cube.producer, &cfg.p);
    if ASCEND_IS_AIV {
        vec.Init(pipe);
        GlobalTensor<Low> ag, rg;
        GlobalTensor<float> og;
        ag.SetGlobalBuffer((__gm__ Low*)a);
        rg.SetGlobalBuffer((__gm__ Low*)dr);
        og.SetGlobalBuffer((__gm__ float*)out);
        DataCopy(vec.a, ag, Chunk * Rows);
        DataCopy(vec.b, rg, Chunk * Feature);
        vec.LoadFence();
        cube.Produce(vec.a, vec.b, vec.result);
        PipeBarrier<PIPE_ALL>();
        vec.StoreFence();
        DataCopy(og[GetBlockIdx() * Rows * Feature], vec.result, Rows * Feature);
        vec.ReuseFence();
    }
}

extern "C" void launch_kda_matmul_probe(void* stream, uint8_t* a, uint8_t* dr,
    uint8_t* out, uint8_t* workspace, ResidualConfig cfg) {
    kda_matmul_probe<<<1, nullptr, stream>>>(a, dr, out, workspace, cfg);
}

extern "C" void launch_kda_residual_native(uint32_t blocks, void* stream,
    uint8_t* value, uint8_t* residual, uint8_t* inverse, uint8_t* dr,
    uint8_t* state, uint8_t* key, uint8_t* gate, uint8_t* beta,
    uint8_t* dk, uint8_t* dg, uint8_t* dv, uint8_t* db, uint8_t* dm,
    uint8_t* workspace, ResidualConfig cfg) {
    kda_residual_native<<<blocks, nullptr, stream>>>(value, residual, inverse, dr,
        state, key, gate, beta, dk, dg, dv, db, dm, workspace, cfg);
}
