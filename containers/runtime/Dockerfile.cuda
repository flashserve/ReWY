FROM nvidia/cuda:12.8.1-devel-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/fdr
ENV PATH="/opt/fdr/bin:${PATH}"
WORKDIR /opt/fast-delta-rule
COPY . .
RUN bash scripts/install.sh cuda
WORKDIR /workspace
ENTRYPOINT ["fdr"]
CMD ["doctor", "--check-sources"]
